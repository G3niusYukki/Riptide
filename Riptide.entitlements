<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox (required for Mac App Store submission) -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Network access (HTTP CONNECT proxy, mihomo API) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Apple Events (AppleScript automation) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Hardened runtime (required for notarization) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network Extension (预留, 当前不用 NE) -->
    <!-- <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array> -->

    <!-- Sparkle auto-update (read by Sparkle.framework at runtime, Sparkle 2.6+).
         The public key here MUST match the private key stored in the
         SPARKLE_PRIVATE_KEY GitHub Secret. Generate the pair with:
             ./Scripts/sign-sparkle-update.sh keygen
         See Resources/sparkle-pubkey.pem for the human-readable record. -->
    <key>SUFeedURL</key>
    <string>https://riptide.app/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>REPLACE_ME_WITH_GENERATED_BASE64_PUBLIC_KEY</string>
</dict>
</plist>
